[app]
name = "council-deliberation"
script = "./task.py"
source = [
    "./task.py",
    "./**/*.py",
    "requirements.txt",
]
import_paths = [
    ".",
]

# ── Pipeline Parameters ─────────────────────────────────────────────────

[[parameters]]
name = "topic"
description = "The decision topic or question for the council to deliberate on."
default = "Should the Federal Reserve maintain or cut interest rates in Q3 2026?"

[[parameters]]
name = "domain"
description = "Domain of the deliberation: finance, strategy, or general."
default = "finance"

[[parameters]]
name = "context"
description = "Additional context or background information for the deliberation."
default = ""

[[parameters]]
name = "fetch_data"
description = "Whether the Data Agent may fetch external market context."
default = "true"

[[parameters]]
name = "mode"
description = "Execution mode: agent (Data Agent tool loop) or pipeline (legacy fixed flow)."
default = "agent"

[[parameters]]
name = "max_agent_steps"
description = "Maximum tool-calling steps for the Data Agent orchestrator."
default = "20"

[[parameters]]
name = "output_file"
description = "Path to write the JSON output file (optional)."
default = ""
